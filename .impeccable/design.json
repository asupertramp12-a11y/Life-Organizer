      "kind": "button",
      "refersTo": "button-primary",
      "description": "Graphite text button for confirming actions.",
      "html": "<button class=\"ds-btn\">Back up now</button>",
      "css": ".ds-btn{font:600 15px/1 var(--font);display:inline-flex;align-items:center;gap:6px;min-height:46px;padding:0 18px;border:0;border-radius:var(--r-ctl);background:var(--ink);color:#fff;cursor:pointer;box-shadow:0 1px 0 rgba(255,255,255,.12) inset,0 3px 8px -4px rgba(28,29,31,.5);transition:transform .12s var(--ease),background-color .15s}.ds-btn:hover{background:#2C2D30}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--signal);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Raised panel-white secondary button.",
      "html": "<button class=\"ds-btn-ghost\">Restore</button>",
      "css": ".ds-btn-ghost{font:600 15px/1 var(--font);min-height:46px;padding:0 18px;border:1px solid var(--line);border-radius:var(--r-ctl);background:var(--panel);color:var(--ink);cursor:pointer;box-shadow:var(--shadow-key);transition:transform .12s var(--ease)}.ds-btn-ghost:active{transform:translateY(1px)}.ds-btn-ghost:focus-visible{outline:2px solid var(--signal);outline-offset:2px}"
    },
    {
      "name": "Signal Key",
      "kind": "button",
      "refersTo": "key-signal",
      "description": "Round orange add key; one per screen, beside capture.",
      "html": "<button class=\"ds-key-signal\" aria-label=\"Add task\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-key-signal{display:inline-grid;place-items:center;width:50px;height:50px;padding:0;border-radius:50%;border:1px solid var(--signal);background:var(--signal);color:#fff;cursor:pointer;box-shadow:0 1px 0 rgba(255,255,255,.3) inset,0 4px 10px -4px rgba(229,83,26,.7);transition:transform .12s var(--ease),background-color .15s}.ds-key-signal:hover{background:#D44812}.ds-key-signal:active{transform:translateY(1px) scale(.97)}.ds-key-signal:focus-visible{outline:2px solid var(--signal);outline-offset:2px}"
    },
    {
      "name": "Capture Input",
      "kind": "input",
